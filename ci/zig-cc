#!/usr/bin/env bash
set -eu

if [ $# -lt 1 ]; then
  echo "usage: zig-cc <zig-target> [cc-args...]" >&2
  exit 2
fi

zig_target=$1
shift

zigbin=$(command -v zig || true)
if [ -z "$zigbin" ] && [ -x "${HOME}/zig/zig" ]; then
  zigbin="${HOME}/zig/zig"
fi
if [ -z "$zigbin" ]; then
  echo "zig-cc: zig not on PATH" >&2
  exit 1
fi

args=()
skip=0
for arg in "$@"; do
  if [ "$skip" -eq 1 ]; then
    skip=0
    continue
  fi
  case "$arg" in
    --target=* | -target=*)
      continue
      ;;
    --target | -target)
      skip=1
      continue
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

exec "$zigbin" cc -target "$zig_target" "${args[@]}"
